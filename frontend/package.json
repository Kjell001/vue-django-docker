{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:docker": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint ./src/**/*{.vue,.js} --fix",
    "format": "prettier --write src/",
    "hooks": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "date-fns": "^4.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "lint-staged": {
    "src/**/*.{js,cjs,mjs,vue,html,css}": "yarn prettier --write",
    "src/**/*.{js,cjs,mjs,vue}": "yarn eslint --fix"
  },
  "packageManager": "yarn@4.18.1"
}
